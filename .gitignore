# ==============================================================================
# NEXUS — repository .gitignore
# Scoped to what this repo actually contains (Django backend + Vite frontend +
# Docker). Deliberately NOT a giant generic template.
# ==============================================================================

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Local agent / tooling state ---
.claude/

# --- Secrets & local config -------------------------------------------------
# `.env.example` is committed; every real `.env*` is not.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Python / Django (backend/) ---
__pycache__/
*.py[cod]
.venv/
venv/
ENV/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
# Local database + collected static (both are regenerated)
*.sqlite3
*.sqlite3-journal
backend/staticfiles/
backend/media/

# --- Node / Vite (frontend/) ---
node_modules/
frontend/dist/
.eslintcache
.vite/
*.local

# --- Docker / runtime ---
docker-compose.override.yml

# --- Logs ---
*.log
