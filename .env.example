# ==============================================================================
# NEXUS Environment Template (.env.example)
# Copy this file to '.env' and fill in local values. DO NOT commit actual '.env'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / General Settings
# ------------------------------------------------------------------------------
PROJECT_NAME=NEXUS
ENVIRONMENT=development  # development, staging, production, testing

# ------------------------------------------------------------------------------
# 2. Django Backend Settings
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-64-character-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection Settings
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexus_db
DB_USER=nexus_user
DB_PASSWORD=nexus_secure_password_123!
DB_HOST=localhost  # Use 'db' if running inside Docker Compose
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. Redis & Celery Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost  # Use 'redis' if running inside Docker Compose
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. External Integrations (Gemini API)
# ------------------------------------------------------------------------------
# Your Google Gemini API Key. Retrieve from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. React Frontend Settings (Vite Prefix)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=NEXUS
VITE_ENVIRONMENT=development
