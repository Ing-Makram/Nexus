# ==============================================================================
# NEXUS environment template
# Copy to `.env` and fill in real local values. `.env` is gitignored — never
# commit it. In production, every value below is supplied by the deployment
# environment / secret store, not a file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General
# ------------------------------------------------------------------------------
PROJECT_NAME=NEXUS
ENVIRONMENT=development          # development | production  (selects the settings module)

# ------------------------------------------------------------------------------
# 2. Django backend
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
DEBUG=True
SECRET_KEY=dev-only-change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production-only (config.settings.production). SECRET_KEY and ALLOWED_HOSTS
# above are REQUIRED in production — the process refuses to start without them.
# The rest are optional overrides:
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
CONN_MAX_AGE=60                  # persistent DB connection lifetime (seconds)
SECURE_SSL_REDIRECT=true         # keep true behind TLS; /health/ probes are exempt
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 2b. Production runtime (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                   # application/framework log verbosity
LOG_FORMAT=json                  # "json" (production default) or "plain"
PROXY_PORT=8080                  # host port the nginx reverse proxy listens on
RUN_MIGRATIONS=true              # apply migrations on backend container start
RUN_COLLECTSTATIC=true           # run collectstatic on backend container start
GUNICORN_WORKERS=                # blank -> (2 x CPU cores) + 1
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2c. Error monitoring (OPTIONAL — inactive unless SENTRY_DSN is set)
# ------------------------------------------------------------------------------
SENTRY_DSN=                      # e.g. https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=                  # e.g. a git SHA or version tag
SENTRY_TRACES_SAMPLE_RATE=0      # 0 disables performance tracing

# ------------------------------------------------------------------------------
# 3. PostgreSQL
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexus_db
DB_USER=nexus_user
DB_PASSWORD=change-me-local-dev-password
DB_HOST=localhost               # use 'db' inside Docker Compose
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. Redis / Celery  (development scaffolding only — no application tasks yet;
#    not used by the production stack. See docs/adr/005-future-microservices.md)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost            # use 'redis' inside Docker Compose
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. React frontend (Vite — VITE_ prefix is exposed to the browser)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1   # the production image bakes in /api/v1 (same origin)
VITE_APP_NAME=NEXUS
VITE_ENVIRONMENT=development
